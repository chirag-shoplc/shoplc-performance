# --- Supabase (Project Settings -> API) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, never exposed to the browser

# --- GTmetrix (Account -> API Key) ---
GTMETRIX_API_KEY=your-gtmetrix-api-key
GTMETRIX_LOCATION=Chicago      # default test location (same as the original monitor's Shop LC setting). City name or GTmetrix id; per-URL override in the UI.
GTMETRIX_BROWSER=3             # 3 = Chrome
GTMETRIX_MAX_CONCURRENT=2      # parallel tests your GTmetrix plan allows
GTMETRIX_RETENTION=            # optional: months GTmetrix keeps report links live (1, 6, 12, 24 — depends on your plan)
GTMETRIX_MOBILE_DEVICE=        # optional PRO device id (e.g. from /api/2.0/simulated-devices). Blank = viewport+throttle emulation

# --- Access ---
ADMIN_PASSWORD=choose-a-strong-passphrase   # unlocks Run Tests + Edit URLs
SITE_PASSWORD=                              # leave EMPTY so anyone with the link can view (like the original). Set only to require a login for viewing.
SESSION_SECRET=long-random-string           # signs login cookies
CRON_SECRET=long-random-string              # Vercel sends this to /api/cron automatically

# --- Misc ---
APP_TIMEZONE=Europe/London     # decides what "today" means for a run (same as the original)
