# Shared password for the /admin upload page.
ADMIN_PASSWORD=change-me

# Secret used to sign the admin session cookie. Any long random string.
SESSION_SECRET=change-me-too-something-long-and-random

# Provided automatically by Vercel once you add a Blob store to the project
# (Project -> Storage -> Create Database -> Blob). Only needed manually for
# local development — copy the value from Vercel's dashboard.
BLOB_READ_WRITE_TOKEN=
